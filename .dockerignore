# Only application/build inputs enter the Docker build context.
**
!app/
!app/**
!components/
!components/**
!lib/
!lib/**
!src/
!src/**
!electron/
!electron/*.cjs
!public/
!public/**
!skills/
!skills/**
!scripts/
!scripts/build-server.mjs
!scripts/smoke-server.mjs
!scripts/smoke-demo-runtime.mjs
!scripts/smoke-provider-runtime.mjs
!package.json
!package-lock.json
!config.ts
!next.config.ts
!next-env.d.ts
!tsconfig.json
!postcss.config.mjs
!proxy.ts
!LICENSE

# Keep secrets excluded even if placed inside an allowed source directory.
**/.env*
**/auth.json
**/.auth.json.tmp-*
**/*-credentials.json*
**/*.pem
**/*.key
