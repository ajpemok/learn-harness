# Authoring source is required; local dependencies and generated bundles are not.
**/node_modules
plugins/*/.sdk
plugins/*/dist
**/.git
plugins/*/data
plugins/*/core-plugin-data
**/*.log
public/plugin-authoring

# Keep secrets excluded even if placed inside an allowed source directory.
**/.env*
**/auth.json
**/.auth.json.tmp-*
**/*-credentials.json*
**/*.pem
**/*.key
